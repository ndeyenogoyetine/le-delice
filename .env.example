# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne partagez JAMAIS votre fichier .env (il contient des secrets).

# Port du serveur
PORT=3000

# Clé secrète pour signer les tokens de connexion (mettez une longue phrase aléatoire)
JWT_SECRET=changez_moi_par_une_longue_phrase_secrete_aleatoire

# Clés Stripe (Développeurs > Clés API sur dashboard.stripe.com, mode Test pour commencer)
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique

# Adresse de base du site (utilisée pour les redirections Stripe après paiement)
BASE_URL=http://localhost:3000

# Numéros Orange Money / Wave du restaurant (affichés au client pour le transfert manuel)
ORANGE_MONEY_NUMBER=+221 78 536 77 97
WAVE_NUMBER=+221 78 536 77 97

# Compte administrateur (créé automatiquement au premier démarrage)
ADMIN_EMAIL=admin@ledelice.sn
ADMIN_PASSWORD=ChangezMoi@2026
